/*
 * SPDX-License-Identifier: MIT
 *
 * Put a Thermo sensor on native_sim's emulated I2C controller, at address 0x48. On a board, this
 * node would go on the I2C bus the part is soldered to, and nothing else would change.
 */

&i2c0 {
	thermo: thermo@48 {
		compatible = "qacademy,thermo";
		reg = <0x48>;
	};
};
