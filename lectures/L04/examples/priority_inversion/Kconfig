# The application's own option: which primitive protects the shared resource.

menu "Application"

config APP_USE_MUTEX
	bool "Protect the resource with a k_mutex instead of a k_sem"
	help
	  A k_mutex raises the priority of the thread that holds it to that of the highest-priority
	  thread waiting for it (priority inheritance). A k_sem used as a lock does not.

endmenu

source "Kconfig.zephyr"
